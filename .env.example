# Copy to .env and fill in. Never commit the result.

# From @BotFather.
SAV_BOT_TOKEN=

# The group being moderated, and the private admin chat. Both are negative numbers
# for supergroups, e.g. -1001234567890.
SAV_MAIN_CHAT_ID=
SAV_ADMIN_CHAT_ID=

# Key for the active provider. Groq is the default: https://console.groq.com/keys
GROQ_API_KEY=

# Only needed if you switch back with SAV_LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=

# SAV_LLM_PROVIDER=groq

# Optional: override the models for the active provider. Free catalogues change without
# notice — check these are still live before a long run, because a wrong id fails every
# call and the only symptom is the whole chain failing.
# SAV_PRIMARY_MODEL=
# SAV_FALLBACK_MODEL=
# SAV_PROFILE_MODEL=

# Optional: start somewhere other than dry run. Runtime changes made with /mode
# persist in the database and take precedence over this.
# SAVONAROLA_OPERATING_MODE=LOG_ONLY
